   <string notr="true">QDoubleSpinBox {
    background-color: #1a1d3a;
    border: 2px solid #2f3566;
    border-radius: 10px;
    padding: 6px 10px;
    min-width: 70px;
    font-weight: 700;
    color: #ffffff;
}

QDoubleSpinBox:focus {
    border-color: #00d4ff;
}

QTextEdit, QPlainTextEdit {
    background-color: #12142b;
    border: 2px solid #2f3566;
    border-radius: 12px;
    padding: 8px;
    color: #c9cdee;
    font-family: &quot;JetBrains Mono&quot;, &quot;Consolas&quot;, monospace;
    font-size: 13px;
}

QLabel#label_status {
    padding: 8px 14px;
    border-radius: 10px;
    font-weight: 700;
    background-color: rgba(127, 231, 255, 0.10);
    border-left: 4px solid #7fe7ff;
    color: #7fe7ff;
}

QLabel#label_status[state=&quot;ok&quot;] {
    background-color: rgba(61, 220, 151, 0.12);
    border-left-color: #3ddc97;
    color: #3ddc97;
}

QLabel#label_status[state=&quot;warn&quot;] {
    background-color: rgba(255, 184, 77, 0.12);
    border-left-color: #ffb84d;
    color: #ffb84d;
}

QLabel#label_status[state=&quot;error&quot;] {
    background-color: rgba(255, 82, 82, 0.12);
    border-left-color: #ff5252;
    color: #ff5252;
}
QMainWindow, QWidget#centralwidget {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #0f1020, stop:0.5 #141629, stop:1 #1b1033);
}

QWidget {
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;, &quot;Noto Sans&quot;, sans-serif;
