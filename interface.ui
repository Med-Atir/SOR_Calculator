QSpinBox {
    background-color: #1a1d3a;
    border: 2px solid #2f3566;
    border-radius: 10px;
    padding: 6px 10px;
    min-width: 70px;
    font-weight: 700;
    color: #ffffff;
    selection-background-color: #5b4bff;
}

QSpinBox:hover {
    border-color: #5b4bff;
}

QSpinBox:focus {
    border-color: #00d4ff;
    background-color: #20244a;
}

QSpinBox::up-button, QSpinBox::down-button {
    subcontrol-origin: border;
    width: 20px;
    background-color: #2a2f57;
    border: none;
}

QSpinBox::up-button {
    subcontrol-position: top right;
    border-top-right-radius: 8px;
}

QSpinBox::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: 8px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #5b4bff;
}

QSpinBox::up-arrow, QSpinBox::down-arrow {
    width: 8px;
    height: 8px;
}

QPushButton {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #5b4bff, stop:1 #00b4ff);
    color: #ffffff;
    border: none;
    border-radius: 10px;
    padding: 8px 22px;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 1px;
}

QPushButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #7a6dff, stop:1 #33c6ff);
}

QPushButton:pressed {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #4638cc, stop:1 #0090d1);
    padding-top: 10px;
    padding-bottom: 6px;
}

QPushButton:disabled {
    background-color: #2a2d4a;
    color: #6d7196;
}

QPushButton#set_dim {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #00c6a7, stop:1 #1e90ff);
    padding: 8px 26px;
}

QPushButton#set_dim:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #2eddc0, stop:1 #4aa8ff);
}

QTableWidget, QTableView {
    background-color: #12142b;
    alternate-background-color: #171a38;
    gridline-color: #2a2f57;
    border: 2px solid #2f3566;
    border-radius: 12px;
    selection-background-color: #5b4bff;
    selection-color: #ffffff;
    outline: none;
}

QTableWidget::item {
